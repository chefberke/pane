# InstantDB
# 1. Visit https://www.instantdb.com/dash → create an app → copy the App ID
NEXT_PUBLIC_INSTANT_APP_ID=

# OAuth providers (configured in the InstantDB dashboard, NOT here)
#   1. In the InstantDB dashboard → Auth → OAuth, add a Google client named exactly "google"
#   2. Add a GitHub client named exactly "github"
#   3. Set the authorized redirect URL to:
#         http://localhost:3000/auth/callback     (development)
#         https://<your-domain>/auth/callback     (production)
